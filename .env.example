# Everything here is optional. The demo and the tests need none of it.

# Creative generator: "template" (default, deterministic) or "llm".
PIPELINE_GENERATOR=template

# Needed only for the LLM generator (uv sync --extra llm).
ANTHROPIC_API_KEY=
PIPELINE_LLM_MODEL=claude-sonnet-5-5

# Where outputs go: a local folder (default "out") or gs://bucket/prefix (uv sync --extra gcs).
PIPELINE_STORE=out
# Google credentials for the GCS backend, if you do not use gcloud application-default login.
GOOGLE_APPLICATION_CREDENTIALS=
# Set to 0 to turn off the API's server-side refusal fallback for the LLM generator.
PIPELINE_LLM_FALLBACK=1

# Nothing loads this file automatically. Export the values in your shell,
# or pass the file to uv: uv run --env-file .env python -m pipeline run --profile b2c
